APP_NAME="Hotel Signage Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.onthilaixe.online
CMS_URL=https://hotel-signage-hub-cms.vercel.app
PLAYER_URL=https://hotel-signage-hub-player.vercel.app

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hotel_hub
DB_USERNAME=hotel
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@onthilaixe.online"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=hotel-hub
REVERB_APP_KEY=change-me-key
REVERB_APP_SECRET=change-me-secret
REVERB_HOST=ws.onthilaixe.online
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
